# Application settings
app_name=Customer Support Assistant
app_version=1.0.0
debug=false

# Database settings (use local values for development)
db_host=localhost
db_port=5432
db_name=customer_support
db_user=postgres
db_password=CHANGE_ME
DATABASE_URL=

# AI/search providers (add your own keys locally; never commit real keys)
GEMINI_API_KEY=
TAVILY_API_KEY=
GROQ_API_KEY=

# OAuth integrations
google_client_id=
google_client_secret=
meta_app_id=
meta_app_secret=
meta_verify_token=

# Replace this value with a strong random secret in your local .env
secret_key=CHANGE_ME_TO_A_RANDOM_SECRET

# Comma-separated allowed frontend origins
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:8000
